# EX-Digital Frontend — Vite Environment Variables
# LOCAL DEV: npm run dev on :5173 → direct to backend on :8000
# DOCKER:    nginx proxies /auth/ /courses/ etc. to backend:8000 internally,
#            so set VITE_API_URL to empty string or remove it for Docker builds.

# Backend API base URL — used by apiClient.ts
VITE_API_URL=http://localhost:8000
