# ============================================================
# EX-DIGITAL — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://exdigital:change-me@postgres:5432/exdigital
DATABASE_URL_SYNC=postgresql://exdigital:change-me@postgres:5432/exdigital
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=ec7f683b57fcbae7d9e68f7bf26079bbb34c62d0c0d94013b30eb9dc6dec2d1a
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Session
SESSION_DURATION_MINUTES=10
SESSION_GRACE_PERIOD_MINUTES=5
QR_SCAN_WINDOW_MINUTES=5

# Gateway
HMAC_SECRET=796b805edd229cab0bd6e35d0f8dbfba
GATEWAY_API_KEY=change-me-gateway-api-key

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security
BCRYPT_ROUNDS=12
